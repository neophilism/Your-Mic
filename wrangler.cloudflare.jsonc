{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "your-mic",
  "main": "worker/standalone.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ai": {"binding": "AI"},
  "preview_urls": false,
  "observability": {"enabled": true, "head_sampling_rate": 0.1},
  "limits": {"cpu_ms": 100},
  "d1_databases": [{
    "binding": "DB",
    "database_name": "your-mic",
    // Replace with the ID returned by `wrangler d1 create your-mic`.
    "database_id": "00000000-0000-4000-8000-000000000000",
    "migrations_dir": "drizzle"
  }],
  "r2_buckets": [{"binding": "BUCKET", "bucket_name": "your-mic-audio"}]
  // Set ARTIST_PASSWORD and SESSION_SECRET with `wrangler secret put`.
  // Never put secret values in this file or in Git.
}
